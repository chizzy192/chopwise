# Local PostgreSQL for development. On Neon, use its connection string ending in ?sslmode=require
# (see docs/DEPLOY.md). db:setup only runs against a database on this computer.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chopwise
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
PORT=4000
# The site allowed to call the API with cookies: the Vite dev server, or the API's own
# address (http://localhost:4000) when the server serves the built client.
CLIENT_ORIGIN=http://localhost:5173
# First admin, created by `npm run db:setup`. The password must be at least 10 characters
# and must not be the demo password.
ADMIN_EMAIL=admin@chopwise.ng
ADMIN_PASSWORD=
# Optional display name for the first admin.
# ADMIN_NAME=System Administrator
# Sample caterer, also created by `npm run db:setup` (same password rules).
CATERER_EMAIL=caterer@chopwise.ng
CATERER_PASSWORD=
# CATERER_NAME=Campus Kitchen
# Set to production when deployed (turns on Secure cookies and HTTPS upgrades).
# NODE_ENV=production
# Paystack TEST keys from dashboard.paystack.com (Settings > API Keys & Webhooks).
# The secret key stays on the server; it is never sent to the browser.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: point at a mock Paystack (the system tests do this). Defaults to https://api.paystack.co
# PAYSTACK_API_URL=http://localhost:4100
# 64 hex characters (32 bytes) for encrypting delivery codes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DELIVERY_CODE_KEY=
# Email for password reset links (nodemailer). Leave SMTP_HOST empty in development: the reset
# link is then printed to the server console instead of being sent. Port 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ChopWise <no-reply@chopwise.ng>"
