{
  "name": "chopwise-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ChopWise API: diet control food delivery system with a 3-input majority gate",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "test:system": "node scripts/system-scenarios.js",
    "test:ui": "npm --prefix ../client run test:ui",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "node src/db/setup.js",
    "photos:export": "node scripts/export-photos.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.13.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
